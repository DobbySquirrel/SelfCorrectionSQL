{
    "9": "WITH avg_math_scores AS (\n    SELECT cds, AVG(AvgScrMath) AS avg_math_score\n    FROM satscores\n    GROUP BY cds\n),\nhigh_avg_math AS (\n    SELECT cds\n    FROM avg_math_scores\n    WHERE avg_math_score > 560\n),\ncharter_funded AS (\n    SELECT f.`School Code`\n    FROM high_avg_math h\n    INNER JOIN frpm f ON h.cds = f.`CDSCode`\n    WHERE f.`Charter Funding Type` = 'Directly funded'\n),\nfinal_count AS (\n    SELECT COUNT(*) AS answer\n    FROM charter_funded\n)\nSELECT answer FROM final_count;\t----- bird -----\tcalifornia_schools",
    "21": "WITH f_cols AS (\n    SELECT `CDSCode`, `Free Meal Count (K-12)`\n    FROM frpm\n    WHERE `County Name` = 'Los Angeles'\n),\nf_rows AS (\n    SELECT `CDSCode`\n    FROM f_cols\n    WHERE `Free Meal Count (K-12)` > 500 AND `Free Meal Count (K-12)` < 700\n),\ns_join AS (\n    SELECT s.CDSCode, s.School\n    FROM f_rows fr\n    INNER JOIN schools s ON fr.CDSCode = s.CDSCode\n)\nSELECT COUNT(*) AS answer FROM s_join;\t----- bird -----\tcalifornia_schools",
